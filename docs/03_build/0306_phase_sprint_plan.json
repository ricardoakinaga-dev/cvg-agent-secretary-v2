          "id": "P7-S2",
          "name": "Conversation operations",
          "tasks": ["P7-S2-T01", "P7-S2-T02"],
          "deliverables": ["conversation list", "timeline view"]
        },
        {
          "id": "P7-S3",
          "name": "Approval and task operations",
          "tasks": ["P7-S3-T01", "P7-S3-T02"],
          "deliverables": ["approval queue", "task board", "audit view"]
        }
      ]
    },
    {
