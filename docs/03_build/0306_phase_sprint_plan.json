{
  "version": "1.0.0",
  "status": "waiting_human_approval_for_phase_0",
  "global_validation_commands": [
    "npm test",
    "npm run typecheck",
    "npm run lint",
    "npm run test:coverage",
    "npm audit --audit-level=high"
  ],
  "phases": [
    {
      "id": "P0",
      "name": "Foundation Control",
      "goal": "Create deterministic monorepo foundation, quality gates and security baseline without product behavior.",
      "entry_gate": "human approval for Phase 0 execution",
      "exit_gate": "workspaces, TypeScript, tests, lint, coverage command, env baseline and tracking JSON are present and validated",
      "sprints": [
        {
          "id": "P0-S1",
          "name": "Repository skeleton",
          "tasks": ["P0-S1-T00", "P0-S1-T01", "P0-S1-T02"],
          "deliverables": [
            "npm workspaces",
            "apps/packages directories",
            "base tsconfig"
          ]
        },
        {
          "id": "P0-S2",
          "name": "Quality and security gates",
          "tasks": ["P0-S2-T01", "P0-S2-T02", "P0-S2-T03"],
          "deliverables": [
            "Vitest config",
            "ESLint config",
            ".env.example",
            "secret-safe env schema"
          ]
        },
        {
          "id": "P0-S3",
          "name": "Tracking and dependency audit",
          "tasks": ["P0-S3-T01", "P0-S3-T02"],
          "deliverables": [
            "build tracking JSON",
            "dependency audit report",
            "CI-local command set"
          ]
        }
      ]
    },
    {
      "id": "P1",
      "name": "Shared Contracts",
      "goal": "Create shared contracts consumed by every app and package.",
      "entry_gate": "P0 completed",
      "exit_gate": "all shared schemas have unit tests and package exports are stable",
      "sprints": [
        {
          "id": "P1-S1",
          "name": "Ids and enums",
          "tasks": ["P1-S1-T01", "P1-S1-T02", "P1-S1-T03"],
          "deliverables": [
            "CorrelationId",
            "domain ids",
            "Intent",
            "RiskLevel",
            "AutonomyLevel",
            "ApprovalDecision",
            "TaskPriority"
          ]
        },
        {
          "id": "P1-S2",
          "name": "Envelope, errors and auth contracts",
          "tasks": ["P1-S2-T01", "P1-S2-T02", "P1-S2-T03"],
          "deliverables": [
            "ApiEnvelope",
            "DomainError",
            "Pagination",
            "Role schema",
            "Env schema"
          ]
        },
        {
          "id": "P1-S3",
          "name": "Application and API schemas",
          "tasks": ["P1-S3-T01", "P1-S3-T02"],
          "deliverables": [
            "command schemas from SPEC 0106",
            "endpoint payload schemas from SPEC 0107"
          ]
        }
      ]
    },
    {
      "id": "P2",
      "name": "Persistence and Data Integrity",
      "goal": "Create database schema, repositories, idempotency and audit storage.",
      "entry_gate": "P1 completed",
      "exit_gate": "repositories pass integration tests with transactional behavior",
      "sprints": [
        {
          "id": "P2-S1",
          "name": "Schema and migrations",
          "tasks": ["P2-S1-T01", "P2-S1-T02", "P2-S1-T03"],
          "deliverables": [
            "Drizzle schema",
            "initial migration",
            "data classification fields"
          ]
        },
        {
          "id": "P2-S2",
          "name": "Repositories and idempotency",
          "tasks": ["P2-S2-T01", "P2-S2-T02", "P2-S2-T03"],
          "deliverables": [
            "conversation repository",
            "task repository",
            "idempotency repository"
          ]
        },
        {
          "id": "P2-S3",
          "name": "Audit and outbox",
          "tasks": ["P2-S3-T01", "P2-S3-T02"],
          "deliverables": [
            "audit append-only repository",
            "outbox table and repository"
          ]
        }
      ]
    },
    {
      "id": "P3",
      "name": "Agent Core and Application Commands",
      "goal": "Implement application commands without external integrations.",
      "entry_gate": "P2 completed",
      "exit_gate": "commands from SPEC 0106 pass contract and integration tests",
      "sprints": [
        {
          "id": "P3-S1",
          "name": "Conversation and session commands",
          "tasks": ["P3-S1-T01", "P3-S1-T02", "P3-S1-T03"],
          "deliverables": [
            "ReceiveInboundMessage",
            "SessionManager",
            "GetConversationTimeline"
          ]
        },
        {
          "id": "P3-S2",
          "name": "Task and handoff commands",
          "tasks": ["P3-S2-T01", "P3-S2-T02"],
          "deliverables": ["CreateInternalTask", "CreateHandoffSummary"]
        },
        {
          "id": "P3-S3",
          "name": "Agent run lifecycle",
          "tasks": ["P3-S3-T01", "P3-S3-T02"],
          "deliverables": [
            "RunAgentTurn skeleton",
            "AgentRun state persistence"
          ]
