  ],
  "controlled_sprints": [
    {
      "id": "PLAT-S03",
      "name": "Pre-production tenant isolation boundary",
      "status": "COMPLETED_CONTROLLED",
      "goal": "Enforce tenant isolation at the PostgreSQL boundary without real-data activation.",
      "entry_gate": "PLAT-S02 controlled gate complete and human decision retained for real-data backfill",
      "exit_gate": "Versioned migration, forced RLS fixture evidence, tenant-scoped pool and production startup guard pass",
      "tasks": ["PLAT-S03-001"]
    },
    {
      "id": "PLAT-S04",
      "name": "Durable approval, safe legacy adapter and runtime reliability",
      "status": "COMPLETED_CONTROLLED",
      "goal": "Make approval single-use and durable, and route only the controlled scheduling read through the capability gateway.",
      "entry_gate": "PLAT-S03 controlled gate complete; no real provider/channel activation",
      "exit_gate": "Durable approval replay/expiry/revocation/input-hash tests, allowlist-only dry-run adapter, tenant-scoped runtime wiring, pending/completed retry, atomic finalization and controlled raw-body HMAC/replay tests pass",
      "tasks": ["PLAT-S04-001", "PLAT-S04-002", "PLAT-S04-003"]
    }
  ]
}
