      "entry_gate": "P3 completed",
      "exit_gate": "policy, approval and tool registry tests pass",
      "sprints": [
        {
          "id": "P4-S1",
          "name": "Policy engine",
          "tasks": ["P4-S1-T01", "P4-S1-T02", "P4-S1-T03"],
          "deliverables": [
            "clinical boundary blocks",
            "autonomy decisions",
            "policy version"
          ]
        },
        {
          "id": "P4-S2",
          "name": "Approval state machine",
          "tasks": ["P4-S2-T01", "P4-S2-T02"],
          "deliverables": [
            "RequestHumanApproval",
            "ResolveApproval",
            "single final decision"
          ]
        },
        {
          "id": "P4-S3",
          "name": "Tool registry and local tools",
          "tasks": ["P4-S3-T01", "P4-S3-T02", "P4-S3-T03"],
          "deliverables": [
            "tool registry",
            "owner/patient local tools",
            "scheduling draft local tools"
          ]
        }
      ]
    },
    {
      "id": "P5",
      "name": "Workflows MVP",
      "goal": "Implement the MVP workflows with safety and handoff.",
      "entry_gate": "P4 completed",
      "exit_gate": "all MVP workflow tests pass and sensitive actions remain blocked",
      "sprints": [
        {
          "id": "P5-S1",
          "name": "Intent and owner/patient workflow",
          "tasks": ["P5-S1-T01", "P5-S1-T02"],
          "deliverables": ["intent workflow", "owner/patient workflow"]
        },
        {
          "id": "P5-S2",
          "name": "Triage and handoff",
          "tasks": ["P5-S2-T01", "P5-S2-T02"],
          "deliverables": ["triage workflow", "handoff workflow"]
        },
        {
          "id": "P5-S3",
          "name": "Scheduling draft and institutional question",
          "tasks": ["P5-S3-T01", "P5-S3-T02"],
          "deliverables": [
            "scheduling draft workflow",
            "institutional question safe workflow"
          ]
        }
      ]
