      "goal": "Expose operational endpoints and async processing.",
      "entry_gate": "P5 completed",
      "exit_gate": "API contract tests and worker integration tests pass",
      "sprints": [
        {
          "id": "P6-S1",
          "name": "API shell",
          "tasks": ["P6-S1-T01", "P6-S1-T02"],
          "deliverables": [
            "Fastify app",
            "health route",
            "error envelope",
