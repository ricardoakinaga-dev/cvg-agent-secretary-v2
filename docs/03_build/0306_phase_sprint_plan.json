        {
          "id": "P10-S2",
          "name": "Staging and governance",
          "tasks": ["P10-S2-T01", "P10-S2-T02"],
          "deliverables": [
            "staging checklist",
            "retention sign-off",
            "role mapping sign-off"
          ]
        },
        {
          "id": "P10-S3",
          "name": "Pilot report loop",
          "tasks": ["P10-S3-T01", "P10-S3-T02"],
          "deliverables": ["pilot report template", "remediation loop"]
        }
      ]
