    {
      "id": "P9",
      "name": "Observability, Security and Hardening",
      "goal": "Make runtime auditable, measurable and resilient.",
      "entry_gate": "P8 completed",
      "exit_gate": "audit report has no critical open gaps",
      "sprints": [
