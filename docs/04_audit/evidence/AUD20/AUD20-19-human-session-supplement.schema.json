{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "specSha256",
    "candidateId",
    "candidateTreeHash",
    "human_a11y",
    "releaseEligible",
    "steps"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sessionId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "specSha256": { "const": "decb8d441c2a17678026c6305fb71a9c31a2069d6836ad010362f9c3b9179688" },
    "candidateId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateTreeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "human_a11y": { "const": "PENDING" },
    "releaseEligible": { "const": false },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepId",
        "candidateId",
        "candidateTreeHash",
        "fixtureRole",
        "anchor",
        "initialState",
        "finalState",
        "browser",
        "version",
        "viewport",
        "zoom",
        "startedAt",
        "finishedAt",
        "status",
        "captureId"
      ],
      "properties": {
        "stepId": { "enum": ["H01", "H02", "H03", "H04", "H05", "H06", "H07", "H08", "H09"] },
        "candidateId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "candidateTreeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "fixtureRole": { "enum": ["supervisor", "approver", "admin"] },
        "anchor": { "type": "string", "maxLength": 120 },
        "initialState": { "type": "string", "maxLength": 120 },
        "finalState": { "type": "string", "maxLength": 120 },
        "browser": { "const": "chromium" },
        "version": { "type": "string", "minLength": 1 },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        },
        "zoom": { "const": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
        "captureId": { "const": "none" }
      }
    }
  }
}
