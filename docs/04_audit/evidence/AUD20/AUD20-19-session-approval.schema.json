{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decision", "authorizationSha256", "specSha256", "candidateId", "candidateTreeHash", "allowedSteps", "facilitatorRole", "validFrom", "validUntil", "screenshots", "audio", "video", "externalFacilitatorCheck"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "decision": { "const": "APPROVED_SESSION" },
    "authorizationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "specSha256": { "const": "decb8d441c2a17678026c6305fb71a9c31a2069d6836ad010362f9c3b9179688" },
    "candidateId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateTreeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "allowedSteps": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["H01", "H02", "H03", "H04", "H05", "H06", "H07", "H08", "H09"] } },
    "facilitatorRole": { "const": "AUTHORIZED_FACILITATOR" },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "screenshots": { "const": false },
    "audio": { "const": false },
    "video": { "const": false },
    "externalFacilitatorCheck": { "const": "CONFIRMED" }
  }
}
