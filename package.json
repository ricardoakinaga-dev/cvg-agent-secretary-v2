{
  "name": "cvg-agent-secretary-v2",
  "version": "1.0.0",
  "description": "Enterprise agent secretary runtime for CVG operations",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run --no-file-parallelism --maxWorkers=2",
    "test:coverage": "vitest run --coverage --no-file-parallelism --maxWorkers=2",
    "test:e2e": "playwright test",
    "test:postgres": "vitest run --testTimeout=60000 --no-file-parallelism packages/persistence/src/__tests__/postgres-migration-smoke.test.ts packages/persistence/src/__tests__/tenant-isolation.test.ts packages/persistence/src/__tests__/platform-postgres-smoke.test.ts packages/persistence/src/__tests__/platform-approval-postgres.test.ts apps/api/src/__tests__/postgres-persistence-mode.test.ts apps/api/src/__tests__/webhook-security.test.ts",
    "postgres:baseline": "tsx scripts/baseline-postgres.ts",
    "readiness": "vitest run tests/construction-readiness.test.js",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite --config vite.config.mts build apps/web",
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:web": "vite --config vite.config.mts apps/web --host 0.0.0.0",
    "dev:worker": "tsx apps/worker/src/main.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "audit:security": "npm audit --audit-level=high",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run build && npm test && npm run test:coverage && npm run audit:security",
    "docs:audit": "npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tanstack/react-query": "^5.100.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "jsdom": "^29.1.0",
    "prettier": "^3.8.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
